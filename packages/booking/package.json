{
  "name": "@room/booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./coupon": "./src/coupon/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node ../../scripts/with-local-env.mjs vitest run --dir test",
    "test:coverage": "node ../../scripts/with-local-env.mjs vitest run --coverage --dir test"
  },
  "dependencies": {
    "@room/database": "workspace:*",
    "libphonenumber-js": "1.13.9",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@room/eslint-config": "workspace:*",
    "@room/typescript-config": "workspace:*",
    "@types/node": "24.1.0",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.5"
  }
}
