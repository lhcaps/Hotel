{
  "name": "@room/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./pricing": {
      "types": "./dist/src/pricing.d.ts",
      "default": "./dist/src/pricing.js"
    },
    "./public-room-catalog": {
      "types": "./dist/src/public-room-catalog.d.ts",
      "default": "./dist/src/public-room-catalog.js"
    },
    "./admin": {
      "types": "./dist/src/admin.d.ts",
      "default": "./dist/src/admin.js"
    },
    "./admin-payment-reconciliation": {
      "types": "./dist/src/admin-payment-reconciliation.d.ts",
      "default": "./dist/src/admin-payment-reconciliation.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --dir test",
    "test:coverage": "vitest run --coverage --dir test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@room/eslint-config": "workspace:*",
    "@room/typescript-config": "workspace:*"
  }
}
