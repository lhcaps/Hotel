{
  "name": "room-management",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web-api": "turbo dev --filter=@room/web --filter=@room/api",
    "dev:web": "pnpm --filter @room/web dev",
    "dev:api": "pnpm --filter @room/api dev",
    "dev:worker": "pnpm --filter @room/worker dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "turbo test:unit --concurrency=1",
    "test:auth": "pnpm --filter @room/auth test:unit && pnpm --filter @room/api exec vitest run --exclude dist/** --exclude test/integration/** test/actor-context.test.ts test/admin-permission.guard.test.ts test/admin-session.service.test.ts test/auth-fastify-bridge.test.ts",
    "test:catalog": "pnpm --filter @room/api test:integration",
    "test:integration": "pnpm test:auth && pnpm test:catalog",
    "test:pricing": "pnpm --filter @room/api exec vitest run test/pricing-engine.test.ts",
    "test:availability": "pnpm --filter @room/api exec node ../../scripts/with-local-env.mjs vitest run test/integration/availability.integration.test.ts",
    "test:quotes": "pnpm --filter @room/api exec node ../../scripts/with-local-env.mjs vitest run test/integration/quote.integration.test.ts",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:public": "pnpm exec playwright test -c playwright.public-release.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --tail=200",
    "infra:status": "docker compose ps",
    "db:generate": "pnpm --filter @room/database db:generate",
    "db:check": "pnpm --filter @room/database db:check",
    "db:migrate": "pnpm --filter @room/database db:migrate",
    "db:seed:development": "pnpm --filter @room/database db:seed:development",
    "client:rooms:import": "pnpm --filter @room/database client:rooms:import",
    "db:test": "pnpm --filter @room/database db:test",
    "db:status": "pnpm --filter @room/database db:status",
    "admin:bootstrap": "pnpm --filter @room/auth admin:bootstrap",
    "generate:openapi": "pnpm exec tsx scripts/generate-openapi.mts --write && pnpm exec tsx scripts/generate-public-openapi.mts --write && pnpm exec tsx scripts/generate-operations-openapi.mts --write",
    "check:openapi": "pnpm exec tsx scripts/generate-openapi.mts --check && pnpm exec tsx scripts/generate-public-openapi.mts --check && pnpm exec tsx scripts/generate-operations-openapi.mts --check && pnpm exec tsx scripts/check-openapi-structure.mts && pnpm exec tsx scripts/validate-admin-coupon-schema.mts",
    "check:peace-home-media": "node scripts/verify-peace-home-media.mjs",
    "check:endpoints": "pnpm exec tsx scripts/check-endpoints.mts",
    "check:i18n-critical": "pnpm exec tsx scripts/check-i18n-critical.mts",
    "check:google-oauth": "node scripts/check-google-oauth-config.mjs",
    "check:providers": "node scripts/check-providers.mjs",
    "check:gitleaks-fixtures": "node scripts/check-gitleaks-fixtures.mjs",
    "check:production-runtime": "node scripts/deploy/verify-production-runtime.mjs",
    "test:release-integrity": "node scripts/release/run-tests.mjs",
    "check:release-integrity": "pnpm test:release-integrity",
    "check:runtime-package-manifests": "node --test scripts/deploy/write-runtime-package-manifests.test.mjs",
    "test:e2e:google-live-local": "node scripts/run-provider-live-acceptance.mjs google",
    "test:e2e:momo-sandbox": "node scripts/run-provider-live-acceptance.mjs momo",
    "test:e2e:vnpay-sandbox": "node scripts/run-provider-live-acceptance.mjs vnpay",
    "test:email:live": "node scripts/run-provider-live-acceptance.mjs smtp",
    "check:features": "node scripts/check-features.mjs",
    "generate:endpoint-inventory": "pnpm exec tsx scripts/check-endpoints.mts --write-inventory",
    "storybook:build": "pnpm --filter @room/web storybook:build",
    "verify:database": "pnpm db:check && pnpm --filter @room/database lint && pnpm --filter @room/database typecheck && pnpm --filter @room/database test:unit && pnpm --filter @room/database build && pnpm db:test",
    "audit:deps": "pnpm audit --prod --audit-level=high",
    "demo:preflight": "node scripts/demo/preflight.mjs",
    "demo:db:create": "pnpm --filter @room/database demo:db:create",
    "demo:db:drop": "pnpm --filter @room/database demo:db:drop",
    "demo:seed": "pnpm --filter @room/database demo:seed",
    "demo:phase6": "node scripts/demo/start.mjs",
    "demo:start": "node scripts/demo/start.mjs",
    "demo:start:local": "node scripts/demo/start-local.mjs",
    "demo:verify": "node scripts/demo/verify.mjs",
    "demo:stop": "node scripts/demo/stop.mjs",
    "demo:smoke": "node scripts/demo/self-contained-smoke.mjs",
    "demo:smoke:running": "node scripts/demo/smoke.mjs",
    "demo:rehearse": "node scripts/demo/rehearse.mjs",
    "demo:lifecycle-test": "node scripts/demo/lifecycle-test.mjs",
    "demo:unit": "node scripts/demo/lifecycle.test.mjs",
    "demo:lint": "cd scripts/demo && pnpm exec eslint --config eslint.config.mjs \"**/*.mjs\"",
    "demo:typecheck": "pnpm exec tsc -p scripts/demo/tsconfig.json --noEmit"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.0",
      "next@16.2.11>postcss": "8.5.21",
      "find-my-way": "9.7.0",
      "fast-uri@3": "3.1.5",
      "fast-uri@4": "4.1.2",
      "undici": "7.29.0",
      "brace-expansion": "5.0.9",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.17"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@room/eslint-config": "workspace:*",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "10.7.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "tsx": "4.21.0",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
