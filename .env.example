NODE_ENV=development
LOG_LEVEL=info
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
INTERNAL_API_BASE_URL=http://localhost:3001/api/v1
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
AUTH_BASE_URL=http://localhost:3001
BETTER_AUTH_SECRET=local-dev-only-secret-with-at-least-thirty-two-characters
DATABASE_URL=postgresql://room:room@localhost:5432/room_management
TEST_DATABASE_URL=postgresql://room:room@localhost:5432/room_management_test_base
REDIS_URL=redis://localhost:6379
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@room-management.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@room-management.local
# Non-loopback SMTP providers require both credentials. Keep them out of Git and
# configure SMTP_LIVE_TEST_RECIPIENT only for the opt-in live acceptance command.
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_LIVE_TEST_RECIPIENT=
GUEST_OTP_SECRET=test-guest-otp-secret-32-chars-min-aaaaaa
GUEST_CHALLENGE_REF_SECRET=test-challenge-ref-secret-32-chars-aaaa
GUEST_SESSION_SECRET=test-guest-session-secret-32-chars-aaaa
BOOKING_IP_DIGEST_SECRET=test-ip-digest-secret-32-chars-aaaaa
BOOKING_HOLD_DURATION_MS=900000
GUEST_OTP_TTL_MS=600000
GUEST_OTP_RESEND_COOLDOWN_MS=60000
GUEST_OTP_REQUEST_WINDOW_MS=900000
GUEST_OTP_REQUEST_LIMIT=3
GUEST_OTP_IP_WINDOW_MS=3600000
GUEST_OTP_IP_LIMIT=20
GUEST_SESSION_TTL_MS=1800000
TRUSTED_PROXY_CIDRS=
POSTGRES_USER=room
POSTGRES_PASSWORD=room
POSTGRES_DB=room_management

# Phase 6F local demo runner (optional overrides).
# The demo runner defaults to:
#   DEMO_ADMIN_DATABASE_URL = postgresql://room:room@127.0.0.1:5432/postgres
#   DEMO_WEB_PORT          = 3100
#   DEMO_API_PORT          = 3101
# Override only if the demo loopback PostgreSQL is on a different host
# (CI host names added via `allowedCiHost`). The runner ALWAYS creates a
# disposable database whose name matches
#   /^room_management_demo_[a-zA-Z0-9][a-zA-Z0-9_]*$/
# and tears it down on shutdown. Persistent names (`room_management`,
# `postgres`, `template0`, `template1`) are refused.
#DEMO_ADMIN_DATABASE_URL=postgresql://room:room@127.0.0.1:5432/postgres
#DEMO_WEB_PORT=3100
#DEMO_API_PORT=3101

# Worker scheduler (apps/worker)
# WORKER_MODE controls how the worker process is started. Two explicit
# modes are supported:
#   continuous (default) — runs expiration and outbox jobs on independent
#                         fixed-delay intervals and shuts down on
#                         SIGINT/SIGTERM. This is the runtime mode.
#   once                 — runs expiration once then outbox once, then
#                         exits 0. Use only for recovery / debugging.
# Default mode without an explicit value is `continuous`.
WORKER_MODE=continuous

# Intervals used in continuous mode. Each must be a positive integer.
WORKER_OUTBOX_INTERVAL_MS=2000
WORKER_EXPIRATION_INTERVAL_MS=5000

# Bounded exponential backoff for transient errors. Both must be
# positive; max must be >= error.
WORKER_ERROR_BACKOFF_MS=1000
WORKER_MAX_ERROR_BACKOFF_MS=30000

# Phase 8C payment reconciliation tick (no secret material; values
# outside the documented bounds throw RangeError before any database
# write).
#
# WORKER_RECONCILIATION_INTERVAL_MS:
#   positive integer; placeholder is 5000 (5 s). Lower values increase
#   provider traffic.
# WORKER_RECONCILIATION_BATCH_SIZE:
#   integer 1..200; placeholder is 50. Values outside bounds throw
#   RangeError via validateReconciliationClaimOptions.
# WORKER_RECONCILIATION_LEASE_TTL_MS:
#   integer 1000..300000 (1 s..5 min); placeholder is 30000 (30 s).
#   Lost leases produce LEASE_LOST and retry on the next tick.
# WORKER_RECONCILIATION_QUERY_TIMEOUT_MS:
#   integer 1000..60000 (1 s..60 s); placeholder is 10000 (10 s).
#   Provider query uses an AbortSignal with this timeout.
# WORKER_RECONCILIATION_MAX_ATTEMPTS:
#   integer 1..32; placeholder is 8.
# WORKER_RECONCILIATION_DELAY_MINUTES:
#   comma-separated integer minutes, each 1..1440; placeholder is
#   "1,5,15,60,240". A misconfigured schedule throws RangeError via
#   validateReconciliationPolicy.
WORKER_RECONCILIATION_INTERVAL_MS=5000
WORKER_RECONCILIATION_BATCH_SIZE=50
WORKER_RECONCILIATION_LEASE_TTL_MS=30000
WORKER_RECONCILIATION_QUERY_TIMEOUT_MS=10000
WORKER_RECONCILIATION_MAX_ATTEMPTS=8
WORKER_RECONCILIATION_DELAY_MINUTES=1,5,15,60,240

# Merchant secrets for MoMo and VNPAY are NOT included in this
# checked-in file. They are supplied only through environment variables
# or a secret manager. The schema rejects test placeholders in
# production. Phase 8C introduces no new merchant secret configuration.

# Phase 8B.1 (Gate B) — payment reconciliation settings. These are
# validated by both the API and worker config schemas in
# @room/config so a misconfigured server cannot disable retries or
# explode the worker. The shared server/worker settings keep the API
# render surface and the worker claim batch on the same retry schedule
# and attempt ceiling. The worker-only settings control the background
# claim batch scheduling.
#
# Shared (API + worker)
# PAYMENT_RECONCILIATION_MAX_ATTEMPTS: 1..32, default 8
# PAYMENT_RECONCILIATION_RETRY_DELAYS_MS: comma-separated, strictly
#   increasing, each 1000..86400000 ms (24h). Default mirrors the
#   1m,5m,15m,1h,4h schedule.
PAYMENT_RECONCILIATION_MAX_ATTEMPTS=8
PAYMENT_RECONCILIATION_RETRY_DELAYS_MS=60000,300000,900000,3600000,14400000

# Worker-only claim batch scheduling (apps/worker only)
# WORKER_RECONCILIATION_BATCH_SIZE: 1..100, default 25
# WORKER_RECONCILIATION_LEASE_TTL_MS: 1000..900000 (15m), default 120000
# WORKER_RECONCILIATION_INTERVAL_MS: 1000..3600000 (1h), default 30000
# WORKER_RECONCILIATION_CONCURRENCY: 1..25, default 5
WORKER_RECONCILIATION_BATCH_SIZE=25
WORKER_RECONCILIATION_LEASE_TTL_MS=120000
WORKER_RECONCILIATION_INTERVAL_MS=30000
WORKER_RECONCILIATION_CONCURRENCY=5

# Phase 7F Google customer identity (CUSTOMER-only; ADMIN unaffected).
# When GOOGLE_AUTH_ENABLED=false, Google login is hidden in the UI and
# credentials may be omitted. When true, client id, client secret and
# redirect URI are required, and the redirect URI must use HTTPS in
# production and share the configured WEB_ORIGIN host.
GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback/google
# Optional: override the Better Auth base URL used for Google callbacks.
# GOOGLE_AUTH_BASE_URL=

# The Web reads NEXT_PUBLIC_GOOGLE_AUTH_ENABLED only to render the sign-in
# entry point. Do not place any credential in a NEXT_PUBLIC variable.
#
# Customer-delivery local demo: the loopback simulator-backed MoMo and
# VNPay values below are the canonical LOCAL DEMO defaults. They point
# at the payment simulator on the same host (127.0.0.1:3090) and are
# the only configuration that makes the demo runner boot the API
# successfully. Production deployments MUST override these values with
# the merchant credentials and HTTPS callback URLs the platform has
# registered with the providers. The exact callback routes are:
# MOMO_RETURN_URL=https://<public-api>/api/v1/payments/providers/momo/return
# MOMO_IPN_URL=https://<public-api>/api/v1/webhooks/momo
# VNPAY_RETURN_URL=https://<public-api>/api/v1/payments/providers/vnpay/return
# VNPAY_IPN_URL=https://<public-api>/api/v1/webhooks/vnpay
MOMO_ENABLED=true
MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=PLAYWRIGHT_MOMO
MOMO_ACCESS_KEY=playwright-momo-access-key
MOMO_SECRET_KEY=playwright-momo-secret-key-at-least-thirty-two-characters
MOMO_API_BASE_URL=http://127.0.0.1:3090
MOMO_RETURN_URL=http://127.0.0.1:3001/api/v1/payments/providers/momo/return
MOMO_IPN_URL=http://127.0.0.1:3001/api/v1/webhooks/momo
MOMO_REQUEST_TYPE=captureWallet
MOMO_REQUEST_TIMEOUT_MS=30000
VNPAY_ENABLED=true
VNPAY_ENVIRONMENT=sandbox
VNPAY_TMN_CODE=PLAYWRIGHTVNPAY
VNPAY_HASH_SECRET=playwright-vnpay-secret-at-least-thirty-two-characters
VNPAY_API_BASE_URL=http://127.0.0.1:3090/vnpay-test/pay
VNPAY_RETURN_URL=http://127.0.0.1:3001/api/v1/payments/providers/vnpay/return
VNPAY_IPN_URL=http://127.0.0.1:3001/api/v1/webhooks/vnpay
VNPAY_REQUEST_TIMEOUT_MS=10000

# Loopback payment simulator (Phase 5 local demo only). The simulator
# listens on 127.0.0.1:3090 and is spawned by the demo runner. Production
# deployments do not run the simulator and must remove these values.
PAYMENT_SIMULATOR_BASE_URL=http://127.0.0.1:3090
PAYMENT_SIMULATOR_MOMO_IPN_URL=http://127.0.0.1:3001/api/v1/webhooks/momo
PAYMENT_SIMULATOR_VNPAY_IPN_URL=http://127.0.0.1:3001/api/v1/webhooks/vnpay

# Optional Google Cloud Translation boundary for ADMIN-authored public descriptions.
# It is server-only, disabled by default, and never translates booking, contact,
# payment, status, code, or price data. Static vi/en UI uses local dictionaries.
# GOOGLE_TRANSLATION_ENABLED=false
# GOOGLE_TRANSLATION_API_KEY=
# GOOGLE_TRANSLATION_TIMEOUT_MS=3000
