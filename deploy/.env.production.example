# Copy to deploy/.env.production, replace every REPLACE_WITH_* value, then
# restrict the copied file to the deployment account. This file is a template;
# it cannot pass scripts/deploy/preflight.mjs or start a production service.
NODE_ENV=production
LOG_LEVEL=info
RELEASE_SHA=REPLACE_WITH_FULL_40_CHAR_COMMIT_SHA

PUBLIC_DOMAIN=REPLACE_WITH_PUBLIC_DOMAIN
PAYMENT_DEMO_DOMAIN=REPLACE_WITH_PAYMENT_DEMO_DOMAIN
WEB_ORIGIN=https://REPLACE_WITH_PUBLIC_DOMAIN
NEXT_PUBLIC_API_BASE_URL=https://REPLACE_WITH_PUBLIC_DOMAIN/api/v1
INTERNAL_API_BASE_URL=http://api:3001/api/v1
AUTH_BASE_URL=https://REPLACE_WITH_PUBLIC_DOMAIN
API_HOST=0.0.0.0
API_PORT=3001
WEB_PORT=3000
TRUSTED_PROXY_CIDRS=REPLACE_WITH_CADDY_NETWORK_CIDR

POSTGRES_USER=REPLACE_WITH_POSTGRES_USER
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=REPLACE_WITH_POSTGRES_DATABASE
DATABASE_URL=postgresql://REPLACE_WITH_POSTGRES_USER:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/REPLACE_WITH_POSTGRES_DATABASE
REDIS_URL=redis://redis:6379

MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER@example.com
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER@example.com

BETTER_AUTH_SECRET=REPLACE_WITH_32_PLUS_CHAR_AUTH_SECRET
GUEST_OTP_SECRET=REPLACE_WITH_32_PLUS_CHAR_OTP_SECRET
GUEST_CHALLENGE_REF_SECRET=REPLACE_WITH_32_PLUS_CHAR_CHALLENGE_SECRET
GUEST_SESSION_SECRET=REPLACE_WITH_32_PLUS_CHAR_SESSION_SECRET
BOOKING_IP_DIGEST_SECRET=REPLACE_WITH_32_PLUS_CHAR_IP_DIGEST_SECRET
BOOKING_ACCESS_QR_SECRET=REPLACE_WITH_32_PLUS_CHAR_BOOKING_ACCESS_QR_SECRET

# Keep the no-money simulator disabled in production. It is local/demo-only infrastructure.
PAYMENT_DEMO_ENABLED=false
PAYMENT_DEMO_PUBLIC_ORIGIN=https://REPLACE_WITH_PAYMENT_DEMO_DOMAIN
PAYMENT_DEMO_WEB_ORIGIN=https://REPLACE_WITH_PUBLIC_DOMAIN
PAYMENT_DEMO_INTERNAL_BASE_URL=http://payment-demo:3090
PAYMENT_DEMO_HOST=0.0.0.0
PAYMENT_DEMO_PORT=3090
PAYMENT_DEMO_MOMO_IPN_URL=http://api:3001/api/v1/webhooks/momo
PAYMENT_DEMO_VNPAY_IPN_URL=http://api:3001/api/v1/webhooks/vnpay
PAYMENT_DEMO_CONTROL_TOKEN=REPLACE_WITH_32_PLUS_CHAR_PAYMENT_DEMO_CONTROL_TOKEN

# Enable only after official sandbox credentials and callback URLs are provisioned.
MOMO_ENABLED=false
MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=REPLACE_WITH_MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=REPLACE_WITH_MOMO_ACCESS_KEY
MOMO_SECRET_KEY=REPLACE_WITH_32_PLUS_CHAR_MOMO_SECRET
MOMO_API_BASE_URL=https://test-payment.momo.vn
MOMO_RETURN_URL=https://REPLACE_WITH_PUBLIC_DOMAIN/api/v1/payments/providers/momo/return
MOMO_IPN_URL=https://REPLACE_WITH_PUBLIC_DOMAIN/api/v1/webhooks/momo

VNPAY_ENABLED=false
VNPAY_ENVIRONMENT=sandbox
VNPAY_TMN_CODE=REPLACE_WITH_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=REPLACE_WITH_32_PLUS_CHAR_VNPAY_SECRET
VNPAY_API_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://REPLACE_WITH_PUBLIC_DOMAIN/api/v1/payments/providers/vnpay/return
VNPAY_IPN_URL=https://REPLACE_WITH_PUBLIC_DOMAIN/api/v1/webhooks/vnpay

GOOGLE_AUTH_ENABLED=false
GOOGLE_TRANSLATION_ENABLED=false
