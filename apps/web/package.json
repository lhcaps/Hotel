{
  "name": "@room/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/with-local-env.mjs next dev --port 3000",
    "build": "next build",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --exclude dist/** --passWithNoTests",
    "test:coverage": "vitest run --coverage --exclude dist/** --passWithNoTests",
    "storybook": "storybook dev -p 6006 --config-dir ../../.storybook",
    "storybook:build": "storybook build --config-dir ../../.storybook"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@room/config": "workspace:*",
    "@room/contracts": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.27.0",
    "next": "16.2.11",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "4.16.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@room/eslint-config": "workspace:*",
    "@room/typescript-config": "workspace:*",
    "@storybook/nextjs-vite": "10.5.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jest-axe": "10.0.0",
    "jsdom": "29.1.1",
    "storybook": "10.5.3",
    "tailwindcss": "4.3.3"
  }
}
